{
  "name": "mkondo-wa-lamu",
  "version": "1.0.0",
  "description": "Steer a Lamu dhow through the mangrove channels of the Lamu archipelago, Kenya, rendered live in the browser with three.js. Built on Sakura Fantasy by Bill Chan.",
  "keywords": [
    "threejs",
    "webgl",
    "webgl2",
    "real-time-rendering",
    "game",
    "lamu",
    "kenya",
    "dhow",
    "mangroves",
    "photogrammetry",
    "blender",
    "web-audio"
  ],
  "author": "Joseph Chege",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5191",
    "fetch-textures": "node scripts/fetch-assets.mjs",
    "perf": "node scripts/perf.mjs",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "playwright-core": "^1.63.0",
    "vite": "^8.3.2"
  },
  "contributors": [
    "Bill Chan (Sakura Fantasy, https://github.com/billpwchan/sakura-fantasy)"
  ]
}
